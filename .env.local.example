# Local URL. The Google callback is:
# http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Generate separate long random values; never reuse passwords here.
SESSION_SECRET=
ADMIN_PASSWORD=
# Supabase production database and Storage. Secret key is server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Resend — leave blank until the account/domain is configured.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Thundra International Orders <orders@send.thundrainternational.com>

# Google OAuth Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storefront contact details and currency. All optional — the code falls back to
# the hardcoded defaults shown here if these are left blank.
NEXT_PUBLIC_STORE_WHATSAPP=03086177169
NEXT_PUBLIC_STORE_EMAIL=thundrain@gmail.com
# PKR per 1 USD, used to show PKR prices alongside USD.
NEXT_PUBLIC_USD_RATE=278
