# Local URL. The Google callback is:
# http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Generate separate long random values; never reuse passwords here.
SESSION_SECRET=
ADMIN_PASSWORD=
# Supabase production database and Storage. Secret key is server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Resend — leave blank until the account/domain is configured.
RESEND_API_KEY=
ORDER_EMAIL_FROM=FetchWow Orders <orders@send.fetchwow.online>

# Google OAuth Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
